1:["$","main",null,{"className":"staff-profile-page","children":[["$","header",null,{"className":"staff-profile-nav","children":[["$","a",null,{"href":"/santa-rosa-medical-massage-review/","className":"staff-profile-brand","aria-label":"Santa Rosa Medical Massage home","children":["$","img",null,{"src":"/santa-rosa-medical-massage-review/logo-correct.png","alt":"Santa Rosa Medical Massage"}]}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule now ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","article",null,{"className":"staff-profile-content","children":[["$","a",null,{"className":"staff-profile-back","href":"/santa-rosa-medical-massage-review/#n-content","children":"← Back to Santa Rosa Medical Massage"}],["$","div",null,{"className":"staff-profile-intro","children":[["$","div",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Meet the practice"}],["$","h1",null,{"children":"Jamie"}],["$","p",null,{"className":"staff-profile-credentials","children":"CMT #5420"}],["$","h2",null,{"children":"How do you support mobility after sports or everyday strain?"}],["$","p",null,{"className":"staff-profile-answer","children":"Jamie brings therapeutic massage, sports massage, movement guidance, and whole-person care to goals around pain, mobility, and stress management."}]]}],["$","img",null,{"className":"staff-profile-image","src":"/santa-rosa-medical-massage-review/site-photo-intake/client-lounge-burgundy.jpeg","alt":"Jamie, Santa Rosa Medical Massage practitioner"}]]}],["$","section",null,{"className":"staff-profile-copy","children":[["$","div",null,{"children":[["$","h2",null,{"children":["About ","Jamie"]}],["$","p",null,{"children":"Jamie has been practicing therapeutic massage and wellness work since 2009. Her training includes sports massage, Trigger Point Therapy, acupuncture, reflexology, Reiki, cupping, myofascial release, and Gua Sha. With intuitive touch and practical movement guidance, Jamie focuses on helping clients decrease pain, improve mobility, and manage stress through a whole-person approach."}]]}],["$","aside",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Choosing care"}],["$","h2",null,{"children":"Why this may be a good option"}],["$","p",null,{"children":"For a goal such as moving more comfortably after activity, managing a recurring training-related tightness, or returning to a favorite routine, Jamie can help shape a session around function as well as relaxation. Her sports and therapeutic background makes her a useful option for clients who want to connect bodywork with everyday movement."}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule an appointment ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","section",null,{"className":"staff-profile-award","children":[["$","p",null,{"className":"staff-profile-kicker","children":"Award-recognized care"}],["$","p",null,{"children":"Santa Rosa Medical Massage is an award-winning, award-recognized practice, with BusinessRate Best of 2025 recognition and a 2026 BusinessRate Award Winner, Massage Therapist honor."}]]}]]}],["$","footer",null,{"className":"staff-profile-footer","children":[["$","img",null,{"src":"/santa-rosa-medical-massage-review/logo-correct.png","alt":"Santa Rosa Medical Massage"}],["$","span",null,{"children":"630 Third Street, Suite B, Santa Rosa, CA 95404"}]]}]]}]
