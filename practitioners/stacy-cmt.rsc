1:["$","main",null,{"className":"staff-profile-page","children":[["$","header",null,{"className":"staff-profile-nav","children":[["$","a",null,{"href":"/santa-rosa-medical-massage-review/","className":"staff-profile-brand","aria-label":"Santa Rosa Medical Massage home","children":["$","img",null,{"src":"/santa-rosa-medical-massage-review/logo-correct.png","alt":"Santa Rosa Medical Massage"}]}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule now ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","article",null,{"className":"staff-profile-content","children":[["$","a",null,{"className":"staff-profile-back","href":"/santa-rosa-medical-massage-review/#n-content","children":"← Back to Santa Rosa Medical Massage"}],["$","div",null,{"className":"staff-profile-intro","children":[["$","div",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Meet the practice"}],["$","h1",null,{"children":"Stacy"}],["$","p",null,{"className":"staff-profile-credentials","children":"CMT #14021"}],["$","h2",null,{"children":"How do you address pain alongside nervous-system regulation?"}],["$","p",null,{"className":"staff-profile-answer","children":"Stacy brings neuromuscular therapy, trigger point work, Somatic Experiencing, and a range of supportive therapeutic modalities to individualized care."}]]}],["$","img",null,{"className":"staff-profile-image","src":"/santa-rosa-medical-massage-review/site-photo-intake/client-lounge-green.jpeg","alt":"Stacy, Santa Rosa Medical Massage practitioner"}]]}],["$","section",null,{"className":"staff-profile-copy","children":[["$","div",null,{"children":[["$","h2",null,{"children":["About ","Stacy"]}],["$","p",null,{"children":"Stacy has practiced neuromuscular therapy since 2010 and became a Somatic Experiencing Practitioner in 2023. Her work combines intuitive, touch-focused Trigger Point Therapy for pain with Somatic Experiencing, an approach centered on the nervous system and body in relation to trauma and PTSD. Her published modalities include neuromuscular therapy, Reiki, sports massage, myofascial release, deep tissue work, Trigger Point Therapy, electronic cupping, PNF stretching, Tok Sen, and supportive tools such as percussion, cupping, scrapers, Gua Sha, CBD lubricant, and ROC tape when appropriate."}]]}],["$","aside",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Choosing care"}],["$","h2",null,{"children":"Why this may be a good option"}],["$","p",null,{"children":"Stacy may be a good fit for clients who want a conversation about pain reduction, nervous-system regulation, and individualized therapeutic care. She has particular interest in the psoas, gluteal muscles, and neck and shoulders, and can help identify an approach that respects comfort, goals, and relevant health context."}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule an appointment ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","section",null,{"className":"staff-profile-award","children":[["$","p",null,{"className":"staff-profile-kicker","children":"Award-recognized care"}],["$","p",null,{"children":"Santa Rosa Medical Massage is an award-winning, award-recognized practice, with BusinessRate Best of 2025 recognition and a 2026 BusinessRate Award Winner, Massage Therapist honor."}]]}]]}],["$","footer",null,{"className":"staff-profile-footer","children":[["$","img",null,{"src":"/santa-rosa-medical-massage-review/logo-correct.png","alt":"Santa Rosa Medical Massage"}],["$","span",null,{"children":"630 Third Street, Suite B, Santa Rosa, CA 95404"}]]}]]}]
