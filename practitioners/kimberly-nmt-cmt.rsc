1:["$","main",null,{"className":"staff-profile-page","children":[["$","header",null,{"className":"staff-profile-nav","children":[["$","a",null,{"href":"/santa-rosa-medical-massage-review/","className":"staff-profile-brand","aria-label":"Santa Rosa Medical Massage home","children":["$","img",null,{"src":"/santa-rosa-medical-massage-review/logo-correct.png","alt":"Santa Rosa Medical Massage"}]}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule now ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","article",null,{"className":"staff-profile-content","children":[["$","a",null,{"className":"staff-profile-back","href":"/santa-rosa-medical-massage-review/#n-content","children":"← Back to Santa Rosa Medical Massage"}],["$","div",null,{"className":"staff-profile-intro","children":[["$","div",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Meet the practice"}],["$","h1",null,{"children":"Kimberly"}],["$","p",null,{"className":"staff-profile-credentials","children":"NMT, CMT"}],["$","h2",null,{"children":"How do you support recovery when pain and stress feel connected?"}],["$","p",null,{"className":"staff-profile-answer","children":"Kimberly combines neuromuscular therapy, trigger point pain-pattern knowledge, and vagus toning training with a nervous-system-aware approach."}]]}],["$","img",null,{"className":"staff-profile-image","src":"/santa-rosa-medical-massage-review/site-photo-intake/client-lounge-black.jpeg","alt":"Kimberly, Santa Rosa Medical Massage practitioner"}]]}],["$","section",null,{"className":"staff-profile-copy","children":[["$","div",null,{"children":[["$","h2",null,{"children":["About ","Kimberly"]}],["$","p",null,{"children":"Kimberly has been practicing as a neuromuscular therapist since 2022, with a focus on trigger point pain patterns and the experience of moving from injury toward recovery. She has additional training in vagus nerve massage and vagus toning. Her work considers both the body and nervous system, with the aim of supporting relief from stress and helping clients shift toward rest and recovery."}]]}],["$","aside",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Choosing care"}],["$","h2",null,{"children":"Why this may be a good option"}],["$","p",null,{"children":"Kimberly may be a good option when a client wants to discuss muscular discomfort in the context of stress, recovery, or feeling stuck in a constantly activated state. Her neuromuscular and vagus-toning training offers a calm, informed starting point for care that supports both physical comfort and a sense of ease."}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule an appointment ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","section",null,{"className":"staff-profile-award","children":[["$","p",null,{"className":"staff-profile-kicker","children":"Award-recognized care"}],["$","p",null,{"children":"Santa Rosa Medical Massage is an award-winning, award-recognized practice, with BusinessRate Best of 2025 recognition and a 2026 BusinessRate Award Winner, Massage Therapist honor."}]]}]]}],["$","footer",null,{"className":"staff-profile-footer","children":[["$","img",null,{"src":"/santa-rosa-medical-massage-review/logo-correct.png","alt":"Santa Rosa Medical Massage"}],["$","span",null,{"children":"630 Third Street, Suite B, Santa Rosa, CA 95404"}]]}]]}]
