1:["$","main",null,{"className":"staff-profile-page","children":[["$","header",null,{"className":"staff-profile-nav","children":[["$","a",null,{"href":"/santa-rosa-medical-massage-review/","className":"staff-profile-brand","aria-label":"Santa Rosa Medical Massage home","children":["$","img",null,{"src":"/santa-rosa-medical-massage-review/logo-correct.png","alt":"Santa Rosa Medical Massage"}]}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule now ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","article",null,{"className":"staff-profile-content","children":[["$","a",null,{"className":"staff-profile-back","href":"/santa-rosa-medical-massage-review/#n-content","children":"← Back to Santa Rosa Medical Massage"}],["$","div",null,{"className":"staff-profile-intro","children":[["$","div",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Meet the practice"}],["$","h1",null,{"children":"Cat"}],["$","p",null,{"className":"staff-profile-credentials","children":"CMT"}],["$","h2",null,{"children":"How do you approach ongoing tension, pain, and inflammation?"}],["$","p",null,{"className":"staff-profile-answer","children":"Cat blends myofascial release, Trigger Point Therapy, neuromuscular work, and cupping in a slow, tailored approach."}]]}],["$","div",null,{"className":"staff-profile-image-frame","children":["$","img",null,{"className":"staff-profile-image","src":"/santa-rosa-medical-massage-review/site-photo-intake/client-lounge-orange.jpeg","alt":"Cat, Santa Rosa Medical Massage practitioner"}]}]]}],["$","section",null,{"className":"staff-profile-copy","children":[["$","div",null,{"children":[["$","h2",null,{"children":["About ","Cat"]}],["$","p",null,{"children":"Cat has been passionate about helping people work with pain, stress, and inflammation since beginning massage training in 2003. Her additional training includes myofascial release, Trigger Point Therapy, cupping, and manual lymphatic drainage. She tailors sessions to each client and may blend myofascial, trigger point, neuromuscular, and cupping approaches while keeping the pace calm and unhurried."}]]}],["$","aside",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Choosing care"}],["$","p",null,{"children":"Cat may be a good fit when a client wants time to work through long-standing tension or stress patterns without rushing the session. Her range of soft-tissue approaches gives her a practical starting point for discussing areas that feel restricted, sore, or persistently overworked."}],["$","a",null,{"className":"staff-profile-book","href":"https://book.squareup.com/appointments/60177225-a91d-4710-9923-a9f3871aca5c/location/1653W5FPZ4EP7/services","children":["Schedule an appointment ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","$Ld",null,{"previous":{"slug":"andrea-cmt","name":"Andrea","credentials":"CMT #84505","question":"How do you treat persistent muscle knots and referred pain?","shortAnswer":"Andrea may be a thoughtful fit for clients looking for focused Trigger Point Therapy and a session shaped around their individual goals.","bio":"Born and raised in Santa Rosa, Andrea is proud to serve the community she has called home throughout her life. She graduated from the National Holistic Institute in 2021, where she developed a foundation in therapeutic bodywork and specialized in Trigger Point Therapy. Her approach combines therapeutic knowledge with intuitive care, so each session can be customized around what a client hopes to feel and do more comfortably.","fit":"For tight, sensitive areas that seem connected to discomfort elsewhere, Andrea can begin with the patterns you are noticing and tailor focused work at a comfortable pace. Her Trigger Point Therapy background makes her a useful option when the goal is to discuss persistent tension, muscle knots, or referred discomfort alongside an overall therapeutic session.","teamPhoto":"client-lounge-stripe.jpeg"},"next":{"slug":"jamie-cmt","name":"Jamie","credentials":"CMT #5420","question":"How do you support mobility after sports or everyday strain?","shortAnswer":"Jamie brings therapeutic massage, sports massage, movement guidance, and whole-person care to goals around pain, mobility, and stress management.","bio":"Jamie has been practicing therapeutic massage and wellness work since 2009. Her training includes sports massage, Trigger Point Therapy, acupuncture, reflexology, Reiki, cupping, myofascial release, and Gua Sha. With intuitive touch and practical movement guidance, Jamie focuses on helping clients decrease pain, improve mobility, and manage stress through a whole-person approach.","fit":"For a goal such as moving more comfortably after activity, managing a recurring training-related tightness, or returning to a favorite routine, Jamie can help shape a session around function as well as relaxation. Her sports and therapeutic background makes her a useful option for clients who want to connect bodywork with everyday movement.","teamPhoto":"client-lounge-burgundy.jpeg"},"base":"/santa-rosa-medical-massage-review"}],"$Le"]}],"$Lf"]}]
