e:["$","section",null,{"className":"staff-profile-award","children":[["$","div",null,{"children":[["$","p",null,{"className":"staff-profile-kicker","children":"Award-recognized care"}],["$","p",null,{"children":"Santa Rosa Medical Massage is an award-winning, award-recognized practice, with BusinessRate Best of 2025 recognition and a 2026 BusinessRate Award Winner, Massage Therapist honor."}]]}],["$","div",null,{"className":"staff-profile-award-badges","aria-label":"Practice awards","children":[["$","img",null,{"src":"/santa-rosa-medical-massage-review/award-businessrate.png","alt":"BusinessRate Best of 2026 Award Winner, Massage Therapist"}],["$","img",null,{"src":"/santa-rosa-medical-massage-review/award-recognition.png","alt":"BusinessRate Best of 2025 Massage Therapist recognition"}]]}]]}]
